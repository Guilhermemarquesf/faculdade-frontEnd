    {
      "id": "iB8f2NuD2z-VPSI9WxJ-E",
      "type": "text",
      "x": 67.68940807524154,
      "y": 967.8600743611648,
      "width": 508.56671142578125,
      "height": 130.50016784667963,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
