      "isDeleted": false,
      "boundElements": null,
      "updated": 1774672977728,
      "link": null,
      "locked": false,
      "text": "                         Palmeiras:\nFundação: 26 de agosto de 1914 (como Palestra Italia).\n\nPrincipais Títulos: O Alviverde é o maior campeão nacional.\n Seus anos de maior glória continental e mundial foram 1951 \n(Copa Rio), 1999, 2020 e 2021 (Libertadores).",
      "fontSize": 17.40002237955728,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                         Palmeiras:\nFundação: 26 de agosto de 1914 (como Palestra Italia).\n\nPrincipais Títulos: O Alviverde é o maior campeão nacional.\n Seus anos de maior glória continental e mundial foram 1951 \n(Copa Rio), 1999, 2020 e 2021 (Libertadores).",
      "autoResize": true,
      "lineHeight": 1.25
    },
